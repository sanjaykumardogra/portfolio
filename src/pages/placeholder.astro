---
import MainLayout from '../layouts/MainLayout.astro';
const base = import.meta.env.BASE_URL;
---

<MainLayout title="Redirecting… | SK Dogra" description="Redirecting to Insights">
  <div class="redirect-page">
    <div class="redirect-card">
      <div class="redirect-icon">
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="24" cy="24" r="22" stroke="url(#rg)" stroke-width="3" stroke-dasharray="8 4" class="orbit"/>
          <path d="M20 16l12 8-12 8V16z" fill="url(#rg2)"/>
          <defs>
            <linearGradient id="rg" x1="0" y1="0" x2="48" y2="48">
              <stop offset="0%" stop-color="#2563eb"/>
              <stop offset="50%" stop-color="#7c3aed"/>
              <stop offset="100%" stop-color="#0891b2"/>
            </linearGradient>
            <linearGradient id="rg2" x1="20" y1="16" x2="32" y2="24">
              <stop offset="0%" stop-color="#2563eb"/>
              <stop offset="100%" stop-color="#0891b2"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
      <h1>Taking you to Insights</h1>
      <p class="redirect-sub">You'll be redirected in a moment…</p>
      <div class="progress-track">
        <div class="progress-bar"></div>
      </div>
      <a href={`${base}blog`} class="manual-link">Go now →</a>
    </div>
  </div>
</MainLayout>

<style>
  .redirect-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    animation: fadeIn 0.4s ease both;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .redirect-card {
    text-align: center;
    max-width: 380px;
    padding: 48px 32px;
  }

  .redirect-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 24px;
  }

  .redirect-icon svg {
    width: 100%;
    height: 100%;
  }

  .orbit {
    animation: spin 3s linear infinite;
    transform-origin: center;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.6rem;
    font-weight: 700;
    background: linear-gradient(135deg, #2563eb, #7c3aed, #0891b2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
  }

  :global(.dark-theme) h1 {
    background: linear-gradient(135deg, #60a5fa, #a78bfa, #22d3ee);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .redirect-sub {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 28px;
  }

  .progress-track {
    width: 100%;
    height: 3px;
    background: var(--border-color-light);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .progress-bar {
    height: 100%;
    width: 0%;
    border-radius: 3px;
    background: linear-gradient(90deg, #2563eb, #7c3aed, #0891b2);
    animation: fillBar 2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes fillBar {
    to { width: 100%; }
  }

  .manual-link {
    color: var(--text-muted);
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 0.2s;
  }

  .manual-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>

<script define:vars={{ base }}>
  setTimeout(() => {
    window.location.href = base + 'blog';
  }, 2000);
</script>
