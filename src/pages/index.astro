---
import MainLayout from '../layouts/MainLayout.astro';
import MarketGlyph from '../components/MarketGlyph.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/formatDate';

const base = import.meta.env.BASE_URL;

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.DEV || !data.draft;
});

const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const recentPosts = sortedPosts.slice(0, 5);
---

<MainLayout title="SK Dogra | Portfolio" description="SK Dogra — Strategic Business Leader | Specification-led Market Development | Government, Public &amp; Private Sectors">

  <section class="hero">
    <div class="hero-badge">
      <span class="hero-badge-primary">Strategic Business Leader</span>
      <span class="hero-badge-secondary"><span class="sector-label">Sectors:</span> <span>Government</span><span>Public</span><span>Private</span></span>
    </div>
    <h1>S K Dogra</h1>
    <p class="hero-subtitle">
      Leading specification-led market development and tertiary sales by connecting products, specifiers, OEMs, projects, institutional markets and trade networks. Building integrated go-to-market systems that convert market intelligence and relationships into specifications, project sales and sustainable growth, with market pull that drives dealer stocking and network growth.
    </p>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-number">
          <span class="stat-value">30<span class="stat-plus">+</span></span>
        </span>
        <span class="stat-label">Work Experience</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-number">
          <span class="stat-value">20<span class="stat-plus">+</span></span>
        </span>
        <span class="stat-label">States</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-number">
          <span class="stat-value">20,000<span class="stat-plus">+</span></span>
        </span>
        <span class="stat-label">Contacts</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat stat-network">
        <span class="stat-number"><span class="stat-value">A2G</span></span>
        <span class="stat-label">Network</span>
      </div>
    </div>
    <section class="market-presence" aria-labelledby="markets-title">
      <h2 id="markets-title">Market <span>Verticals</span></h2>
      <ul class="markets-grid">
        {([
          { name: 'Realty', detail: 'Residential & Non-Resi. Buildings' },
          { name: 'Interiors', detail: 'Floor to Ceiling - Wall to Wall' },
          { name: 'Exteriors', detail: 'Façades, Cladding, Signage' },
          { name: 'Furniture', detail: 'Moveable & Built-in Modular' },
          { name: 'Public Transport', detail: 'Rail Coaches, Bus Body, & Ship Building' },
        ] as const).map((market) => (
          <li class="market-card">
            <MarketGlyph kind={market.name} />
            <span class="market-name">{market.name}</span>
            <span class="market-detail">{market.detail}</span>
          </li>
        ))}
      </ul>
    </section>
  </section>

  <section class="quick-links">
    <div class="link-grid">
      <a href={`${base}whoami`} class="link-card magnetic">
        <span class="link-card-arrow">&rarr;</span>
        <span class="link-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </span>
        <span class="link-card-text">
          <span class="link-card-title">About</span>
          <span class="link-card-desc">Background & expertise</span>
        </span>
      </a>
      <a href={`${base}blog`} class="link-card magnetic">
        <span class="link-card-arrow">&rarr;</span>
        <span class="link-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </span>
        <span class="link-card-text">
          <span class="link-card-title">Insights</span>
          <span class="link-card-desc">Industry perspectives</span>
        </span>
      </a>
      <a href={`${base}random`} class="link-card magnetic">
        <span class="link-card-arrow">&rarr;</span>
        <span class="link-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </span>
        <span class="link-card-text">
          <span class="link-card-title">Career</span>
          <span class="link-card-desc">Timeline & key roles</span>
        </span>
      </a>
      <a href={`${base}ping`} class="link-card magnetic">
        <span class="link-card-arrow">&rarr;</span>
        <span class="link-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </span>
        <span class="link-card-text">
          <span class="link-card-title">Contact</span>
          <span class="link-card-desc">Get in touch</span>
        </span>
      </a>
      <a href={`${base}assets/resume/SKDogra.pdf`} target="_blank" rel="noopener noreferrer" class="link-card link-card-resume magnetic">
        <span class="link-card-arrow">&darr;</span>
        <span class="link-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </span>
        <span class="link-card-text">
          <span class="link-card-title">Resume</span>
          <span class="link-card-desc">Download PDF</span>
        </span>
      </a>
    </div>
  </section>

  <section class="recent-posts">
    <h2>Recent Insights</h2>
    {recentPosts.map((post, i) => {
      const { title, date } = post.data;
      const formattedDate = formatDate(date);

      return (
        <a href={`${base}blog/${post.slug}`} class="post-card">
          <div class="post-card-number">{String(i + 1).padStart(2, '0')}</div>
          <div class="post-card-body">
            <span class="post-card-title">{title}</span>
            <span class="post-card-date">{formattedDate}</span>
          </div>
          <span class="post-card-arrow">&rarr;</span>
        </a>
      );
    })}
  </section>
</MainLayout>

<style>
  .market-presence {
    position: relative;
    z-index: 1;
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--border-color);
  }

  .market-presence h2 {
    margin: 0 0 20px;
    font-family: var(--font-heading);
    font-size: 1.65rem;
    line-height: 1.2;
    color: var(--text-color);
  }
  .market-presence h2 span { color: var(--accent); }

  .markets-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .market-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16px 10px;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--content-bg);
    text-align: center;
  }
  .market-name { margin-top: 12px; font-size: 0.75rem; font-weight: 600; color: var(--text-color); }
  .market-detail { margin-top: 6px; font-size: 0.65rem; line-height: 1.5; color: var(--text-muted); }

  :global(.dark-theme) .market-card { background: #1a202b; border-color: #30394a; }

  .stat-network .stat-number { color: var(--accent); }

  @media (max-width: 600px) {
    .hero .hero-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 24px; }
    .hero-stats .stat-divider { display: none; }
    .markets-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .market-card:last-child { grid-column: 1 / -1; }
    .market-name { font-size: 0.85rem; }
    .market-detail { font-size: 0.75rem; }
  }

  .hero {
    margin: -40px -40px 40px;
    padding: 48px 40px 40px;
    background: var(--hero-bg);
    border-radius: 16px 16px 0 0;
    border-bottom: 1px solid var(--border-color);
    position: relative;
  }

  .hero-badge {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 0;
    width: fit-content;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 28px;
    animation: fadeInUp 0.5s ease both;
    animation-delay: 0.2s;
    position: relative;
    z-index: 1;
    border-radius: 100px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    background: var(--highlight-bg);
  }

  .hero-badge-primary {
    padding: 6px 14px 6px 16px;
    border-right: 1px solid var(--border-color);
    font-weight: 700;

    color: var(--text-color);
    background: none;
    -webkit-text-fill-color: currentColor;
  }

  .hero-badge-secondary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    padding: 6px 16px 6px 14px;
    color: var(--text-muted);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .hero-badge-secondary > span:not(.sector-label)::before {
    content: '·';
    margin-right: 6px;
    color: var(--accent);
  }
  .sector-label { color: var(--text-color); }

  h1 {
    font-family: var(--font-heading);
    font-size: 3.2rem;
    font-weight: 700;
    margin-bottom: 16px;
    letter-spacing: -0.03em;
    line-height: 1.1;
    position: relative;
    z-index: 1;

    color: var(--text-color);
    background: none;
    -webkit-text-fill-color: currentColor;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 720px;
    animation: fadeInUp 0.6s ease both;
    animation-delay: 0.4s;
    position: relative;
    z-index: 1;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin: 28px 0;
    padding: 24px 16px;
    border-radius: 12px;
    background: var(--highlight-bg);
    animation: fadeInUp 0.6s ease both;
    animation-delay: 0.5s;
    position: relative;
    z-index: 1;
    border: 1px solid var(--border-color);
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    padding: 0 12px;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: linear-gradient(180deg, transparent, var(--border-color), transparent);
    flex-shrink: 0;
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 2.4rem;
  }

  .stat-number.compact {
    font-size: 1.55rem;
  }

  .stat-value {
    display: inline-flex;
    align-items: baseline;
  }

  .stat-plus {
    color: var(--accent);
  }

  .stat-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-top: 6px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  p {
    margin-bottom: 14px;
    line-height: 1.7;
  }

  .quick-links {
    margin-bottom: 48px;
    animation: fadeInUp 0.6s ease both;
    animation-delay: 0.3s;
  }

  .link-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .link-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 16px;
    padding: 24px 20px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    border: 1px solid var(--border-color);
    border-radius: 14px;
    background: var(--highlight-bg);
    animation: fadeInUp 0.4s ease both;
    overflow: hidden;
  }

  .link-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--card-clr-glow, var(--accent-glow)), transparent);
    transition: left 0.5s ease;
    pointer-events: none;
  }

  .link-card:hover::before {
    left: 120%;
  }

  .link-card:focus-visible {
    outline: 2px solid var(--card-clr);
    outline-offset: 4px;
  }

  .link-card {
    --card-clr: var(--accent);
    --card-clr-subtle: var(--accent-subtle);
    --card-clr-glow: var(--accent-glow);
    --card-clr-warm: var(--highlight-warm);
    --card-clr-shadow: var(--accent-glow);
  }

  .link-card:hover {
    background: var(--card-clr-warm, var(--highlight-warm));
    text-decoration: none;
    border-color: color-mix(in srgb, var(--card-clr) 30%, var(--border-color));
    box-shadow: 0 12px 32px var(--card-clr-shadow, rgba(0,0,0,0.06)), 0 4px 12px rgba(0, 0, 0, 0.04);
    transform: translateY(-2px);
  }

  .link-card-resume {
    grid-column: 1 / -1;
    border: 1px solid color-mix(in srgb, var(--card-clr) 35%, var(--border-color));
    background: linear-gradient(110deg, var(--card-clr-subtle), var(--highlight-bg));
    box-shadow: none;
  }

  .link-card-resume .link-card-icon {
    background: var(--card-clr);
    color: var(--on-accent);
  }

  .link-card-resume .link-card-title {
    color: var(--card-clr);
    font-weight: 700;
  }

  .link-card-resume .link-card-desc {
    color: var(--text-muted);
  }

  .link-card-resume .link-card-arrow {
    color: var(--card-clr);
  }

  .link-card-resume:hover {
    background: var(--card-clr);
    border-color: var(--card-clr);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px var(--card-clr-shadow), 0 2px 8px var(--card-clr-shadow);
  }

  .link-card-resume:hover .link-card-arrow { border-color: rgba(255,255,255,0.4); }

  .link-card-resume:hover .link-card-title,
  .link-card-resume:hover .link-card-desc,
  .link-card-resume:hover .link-card-arrow {
    color: var(--on-accent);
  }

  .link-card-resume:hover .link-card-icon {
    background: rgba(255, 255, 255, 0.25);
    color: var(--on-accent);
  }

  .link-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--card-clr-subtle, var(--accent-subtle));
    color: var(--card-clr, var(--accent));
    flex-shrink: 0;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .link-card:hover .link-card-icon {
    background: var(--card-clr-glow, var(--accent-glow));
    transform: scale(1.08);
  }

  .link-card-text {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .link-card-title {
    font-weight: 600;
    color: var(--text-color);
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .link-card:hover .link-card-title {
    color: var(--card-clr, var(--accent));
  }

  .link-card-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 4px;
    line-height: 1.4;
  }

  .link-card-arrow {
    position: static;
    order: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border-color);
    border-radius: 50%;
    color: var(--text-muted);
    font-size: 1rem;
    transition: all 0.25s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .link-card { animation: none; transition: none; }
    .link-card::before { display: none; }
    .link-card:hover { transform: none; }
  }

  .link-card:hover .link-card-arrow {
    opacity: 1;
    transform: translate(2px, -2px);
    color: var(--card-clr, var(--accent));
  }

  .recent-posts {
    margin-bottom: 20px;
    animation: fadeInUp 0.6s ease both;
    animation-delay: 0.4s;
  }

  .post-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    margin-bottom: 8px;
    border-radius: 12px;
    text-decoration: none;
    color: var(--text-color);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid transparent;
  }

  .post-card:hover {
    background: var(--highlight-warm);
    border-color: var(--border-color);
    text-decoration: none;
    box-shadow: var(--card-shadow);
    transform: translateX(4px);
  }

  .post-card-number {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent);
    opacity: 0.35;
    min-width: 28px;
    transition: opacity 0.3s ease;
  }

  .post-card:hover .post-card-number {
    opacity: 0.7;
  }

  .post-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .post-card-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-color);
    line-height: 1.4;
    transition: color 0.25s ease;
  }

  .post-card:hover .post-card-title {
    color: var(--accent);
  }

  .post-card-date {
    color: var(--text-subtle);
    font-size: 0.8rem;
  }

  .post-card-arrow {
    font-size: 1.1rem;
    color: var(--text-muted);
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .post-card:hover .post-card-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--accent);
  }

  @media (max-width: 480px) {
    .hero-badge { border-radius: 12px; gap: 0; }
    .hero-badge-primary { width: 100%; border-right: 0; border-bottom: 1px solid var(--border-color); padding: 8px 12px;
    color: var(--text-color);
    background: none;
    -webkit-text-fill-color: currentColor;
  }
    .hero-badge-secondary { font-size: 0.6rem; letter-spacing: 0; gap: 4px; padding: 8px 12px; }
    .hero-badge-secondary > span:not(.sector-label)::before { margin-right: 4px; }

    h1 {
      font-size: 2.3rem;

    color: var(--text-color);
    background: none;
    -webkit-text-fill-color: currentColor;
  }

    .hero {
      margin: -40px -40px 32px;
      padding: 32px 24px 28px;
    }

    .link-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .link-card {
      padding: 18px 20px;
      flex-direction: row;
      align-items: center;
    }

    .link-card-icon {
      width: 40px;
      height: 40px;
    }

    .link-card-arrow {
      position: static;
      margin-left: auto;
    }

    .hero-stats {
      padding: 20px 8px;
    }

    .stat-number {
      font-size: 1.5rem;
      height: 1.8rem;
    }

    .stat-number.compact {
      font-size: 1.15rem;
    }

    .stat-label {
      font-size: 0.65rem;
    }

    .post-card-number {
      display: none;
    }
  }
</style>
