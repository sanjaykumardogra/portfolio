---
const base = import.meta.env.BASE_URL;
const raw = Astro.url.pathname.replace(base, '/').replace(/\/+/g, '/');
const routePath = raw.length > 1 && raw.endsWith('/') ? raw.slice(0, -1) : raw;
---

<header class="header">
  <div class="header-inner">
    <a href={base} class="site-logo">
      <span class="logo-name">SK Dogra</span>
    </a>
    <nav class="nav">
      <a href={base} class={`nav-link magnetic ${routePath === '/' ? 'active' : ''}`}>Home</a>
      <a href={`${base}blog`} class={`nav-link insights-link magnetic ${routePath.startsWith('/blog') ? 'active' : ''}`}><span class="insights-sparkle">✦</span>Insights</a>
      <a href={`${base}random`} class={`nav-link magnetic ${routePath === '/random' ? 'active' : ''}`}>Career</a>
      <a href={`${base}whoami`} class={`nav-link magnetic ${routePath === '/whoami' ? 'active' : ''}`}>About</a>
      <a href={`${base}ping`} class={`nav-link magnetic ${routePath === '/ping' ? 'active' : ''}`}>Contact</a>
      <a href={`${base}assets/resume/SKDogra.pdf`} target="_blank" rel="noopener noreferrer" class="nav-link resume-link magnetic">Resume</a>
    </nav>
    <button id="search-button" class="search-btn magnetic" aria-label="Search">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </button>
  </div>
</header>

<style>
  .header {
    background-color: var(--header-bg);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    animation: slideDown 0.4s ease both;
    transition: border-color 0.3s ease;
  }

  .header.scrolled {
    border-bottom-color: var(--accent-glow);
  }

  .header-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    height: 64px;
    transition: height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .header.scrolled .header-inner {
    height: 52px;
  }

  .site-logo {
    text-decoration: none;
    margin-right: auto;
  }

  .logo-name {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: font-size 0.35s cubic-bezier(0.4, 0, 0.2, 1);

    color: var(--text-color);
    background: none;
    -webkit-text-fill-color: currentColor;
  }


  .header.scrolled .logo-name {
    font-size: 1.05rem;

    color: var(--text-color);
    background: none;
    -webkit-text-fill-color: currentColor;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    --nav-clr: var(--accent);
    --nav-glow: var(--accent-glow);
    color: var(--text-muted);
    text-decoration: none;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.25s, background-color 0.25s, transform 0.2s;
    position: relative;
  }

  .nav-link:hover {
    color: var(--nav-clr, var(--text-color));
    background-color: var(--nav-glow, var(--highlight-bg));
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--nav-clr, var(--accent));
    font-weight: 600;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 12px;
    right: 12px;
    height: 2px;
    background: var(--nav-clr, var(--accent));
    border-radius: 1px;
  }

  .insights-sparkle { display: none; }

  .resume-link,
  :global(.dark-theme) .resume-link {
    background: var(--accent);
    color: var(--on-accent) !important;
    border: 1px solid transparent;
    border-radius: 6px;
    box-shadow: none;
  }
  .resume-link:hover { background: var(--accent-deep); }
  .nav-link:focus-visible, .search-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 12px;
    padding: 8px;
    background: none;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    cursor: pointer;
    color: var(--text-muted);
    transition: all 0.25s ease;
  }

  .search-btn:hover {
    color: var(--accent);
    background-color: var(--accent-subtle);
    border-color: var(--accent);
    transform: scale(1.05);
  }

  @media (max-width: 768px) {
    .header-inner {
      height: 52px;
      padding: 0 12px;
    }

    .nav {
      gap: 0;
    }

    .nav-link {
      font-size: 0.8rem;
      padding: 5px 8px;
    }

    .logo-name {
      font-size: 1.05rem;

    color: var(--text-color);
    background: none;
    -webkit-text-fill-color: currentColor;
  }

    .resume-link {
      display: none;
    }

    .insights-link {
      border: none !important;
      background: none !important;
      box-shadow: none !important;
      animation: none !important;
      padding: 5px 8px;
    }

    .insights-sparkle {
      display: none;
    }

    .search-btn {
      margin-left: 6px;
      padding: 6px;
    }

    .search-btn svg {
      width: 16px;
      height: 16px;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      padding: 0 8px;
    }

    .nav-link {
      font-size: 0.72rem;
      padding: 4px 5px;
    }

    .logo-name {
      font-size: 0.95rem;
      margin-right: 4px;

    color: var(--text-color);
    background: none;
    -webkit-text-fill-color: currentColor;
  }

    .search-btn {
      margin-left: 4px;
      padding: 5px;
    }
  }

  .nav-link { min-height: 40px; display: inline-flex; align-items: center; }
  .nav-link.active { background: var(--accent-subtle); }
  .nav-link.active::after { display: none; }
  .resume-link { border-radius: 100px; }
  @media (max-width: 600px) {
    .header-inner, .header.scrolled .header-inner { height: auto; min-height: 88px; flex-wrap: wrap; padding: 10px 16px; gap: 6px; }
    .site-logo { width: 100%; }
    .nav .resume-link { display: none; }
    .nav { width: 100%; justify-content: space-between; }
    .nav-link { font-size: 0.8125rem; padding: 6px 8px; min-height: 36px; }
    .search-btn { position: absolute; top: 10px; right: 16px; min-height: 32px; min-width: 32px; }
  }

</style>

<script>
  const searchButton = document.getElementById('search-button');
  searchButton?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('toggle-search'));
  });

  const header = document.querySelector('.header');
  if (header) {
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          header.classList.toggle('scrolled', window.scrollY > 80);
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }
</script>
