---
const base = import.meta.env.BASE_URL;
const raw = Astro.url.pathname.replace(base, '/').replace(/\/+/g, '/');
const routePath = raw.length > 1 && raw.endsWith('/') ? raw.slice(0, -1) : raw;
---

<header class="header">
  <div class="header-inner">
    <a href={base} class="site-logo">
      <span class="logo-name">SK Dogra</span>
    </a>
    <nav class="nav">
      <a href={base} class={`nav-link magnetic ${routePath === '/' ? 'active' : ''}`}>Home</a>
      <a href={`${base}blog`} class={`nav-link insights-link magnetic ${routePath.startsWith('/blog') ? 'active' : ''}`}><span class="insights-sparkle">✦</span>Insights</a>
      <a href={`${base}random`} class={`nav-link magnetic ${routePath === '/random' ? 'active' : ''}`}>Career</a>
      <a href={`${base}whoami`} class={`nav-link magnetic ${routePath === '/whoami' ? 'active' : ''}`}>About</a>
      <a href={`${base}ping`} class={`nav-link magnetic ${routePath === '/ping' ? 'active' : ''}`}>Contact</a>
      <a href={`${base}assets/resume/SKDogra.pdf`} target="_blank" rel="noopener noreferrer" class="nav-link resume-link magnetic">Resume</a>
    </nav>
    <button id="search-button" class="search-btn magnetic" aria-label="Search">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </button>
  </div>
</header>

<style>
  .header {
    background-color: var(--header-bg);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    animation: slideDown 0.4s ease both;
    transition: border-color 0.3s ease;
  }

  .header.scrolled {
    border-bottom-color: var(--accent-glow);
  }
  
  .header-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    height: 64px;
    transition: height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .header.scrolled .header-inner {
    height: 52px;
  }
  
  .site-logo {
    text-decoration: none;
    margin-right: auto;
  }
  
  .logo-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 700;
    background: linear-gradient(135deg, #2563eb, #7c3aed, #e11d48);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.02em;
    transition: font-size 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.dark-theme) .logo-name {
    background: linear-gradient(135deg, #60a5fa, #a78bfa, #fb7185);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .header.scrolled .logo-name {
    font-size: 1.05rem;
  }
  
  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  
  .nav-link {
    color: var(--text-muted);
    text-decoration: none;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.25s, background-color 0.25s, transform 0.2s;
    position: relative;
  }

  .nav-link:nth-child(1) { --nav-clr: #2563eb; --nav-glow: rgba(37,99,235,0.08); }
  .nav-link:nth-child(2) { --nav-clr: #0891b2; --nav-glow: rgba(8,145,178,0.08); }
  .nav-link:nth-child(3) { --nav-clr: #e11d48; --nav-glow: rgba(225,29,72,0.08); }
  .nav-link:nth-child(4) { --nav-clr: #d97706; --nav-glow: rgba(217,119,6,0.08); }
  .nav-link:nth-child(5) { --nav-clr: #7c3aed; --nav-glow: rgba(124,58,237,0.08); }

  :global(.dark-theme) .nav-link:nth-child(1) { --nav-clr: #60a5fa; --nav-glow: rgba(96,165,250,0.1); }
  :global(.dark-theme) .nav-link:nth-child(2) { --nav-clr: #22d3ee; --nav-glow: rgba(34,211,238,0.1); }
  :global(.dark-theme) .nav-link:nth-child(3) { --nav-clr: #fb7185; --nav-glow: rgba(251,113,133,0.1); }
  :global(.dark-theme) .nav-link:nth-child(4) { --nav-clr: #fbbf24; --nav-glow: rgba(251,191,36,0.1); }
  :global(.dark-theme) .nav-link:nth-child(5) { --nav-clr: #a78bfa; --nav-glow: rgba(167,139,250,0.1); }
  
  .nav-link:hover {
    color: var(--nav-clr, var(--text-color));
    background-color: var(--nav-glow, var(--highlight-bg));
    text-decoration: none;
  }
  
  .nav-link.active {
    color: var(--nav-clr, var(--accent));
    font-weight: 600;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 12px;
    right: 12px;
    height: 2px;
    background: var(--nav-clr, var(--accent));
    border-radius: 1px;
  }

  .insights-link {
    --nav-clr: #0891b2;
    --i-glow: rgba(8, 145, 178, 0.35);
    background: linear-gradient(135deg, rgba(8,145,178,0.1), rgba(6,182,212,0.06));
    border: 1px solid rgba(8, 145, 178, 0.25);
    border-radius: 8px;
    font-weight: 600;
    color: #0891b2 !important;
    animation: insightsFloat 3s ease-in-out infinite, insightsGlow 2s ease-in-out infinite;
  }

  .insights-sparkle {
    display: inline-block;
    margin-right: 4px;
    font-size: 0.7em;
    animation: sparkleBlink 1.4s ease-in-out infinite;
  }

  @keyframes insightsFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-2px); }
  }

  @keyframes insightsGlow {
    0%, 100% { box-shadow: 0 0 4px var(--i-glow), 0 0 0 transparent; }
    50% { box-shadow: 0 0 10px var(--i-glow), 0 2px 16px rgba(8,145,178,0.15); }
  }

  @keyframes sparkleBlink {
    0%, 100% { opacity: 1; transform: scale(1) rotate(0deg); }
    25% { opacity: 0.3; transform: scale(0.6) rotate(-20deg); }
    50% { opacity: 1; transform: scale(1.2) rotate(10deg); }
    75% { opacity: 0.5; transform: scale(0.8) rotate(-10deg); }
  }

  .insights-link:hover {
    background: linear-gradient(135deg, rgba(8,145,178,0.16), rgba(6,182,212,0.1)) !important;
    border-color: rgba(8, 145, 178, 0.4);
    color: #0891b2 !important;
    animation: none;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(8,145,178,0.2);
  }

  .insights-link:hover .insights-sparkle {
    animation: none;
    opacity: 1;
    transform: scale(1.2);
  }

  .insights-link.active {
    background: rgba(8, 145, 178, 0.12);
    border-color: rgba(8, 145, 178, 0.3);
    color: #0891b2 !important;
  }

  :global(.dark-theme) .insights-link {
    --nav-clr: #22d3ee;
    --i-glow: rgba(34, 211, 238, 0.3);
    background: linear-gradient(135deg, rgba(34,211,238,0.1), rgba(6,182,212,0.06));
    border-color: rgba(34, 211, 238, 0.25);
    color: #22d3ee !important;
  }

  :global(.dark-theme) .insights-link:hover {
    background: linear-gradient(135deg, rgba(34,211,238,0.16), rgba(6,182,212,0.1)) !important;
    border-color: rgba(34, 211, 238, 0.4);
    color: #22d3ee !important;
    box-shadow: 0 4px 14px rgba(34,211,238,0.15);
  }

  :global(.dark-theme) .insights-link.active {
    background: rgba(34, 211, 238, 0.12);
    border-color: rgba(34, 211, 238, 0.3);
    color: #22d3ee !important;
  }

  .resume-link {
    --nav-clr: #7c3aed;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: #fff !important;
    border: 1px solid transparent;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(124,58,237,0.2);
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    animation: resumeGlow 3s ease-in-out infinite;
  }

  :global(.dark-theme) .resume-link {
    --nav-clr: #a78bfa;
    background: linear-gradient(135deg, #60a5fa, #a78bfa);
    box-shadow: 0 2px 8px rgba(167,139,250,0.2);
  }

  @keyframes resumeGlow {
    0%, 100% { box-shadow: 0 2px 8px rgba(124,58,237,0.2); }
    50% { box-shadow: 0 2px 16px rgba(124,58,237,0.3), 0 0 24px rgba(37,99,235,0.15); }
  }

  .resume-link:hover {
    background: linear-gradient(135deg, #2563eb, #7c3aed, #e11d48);
    background-size: 200% 200%;
    border-color: transparent;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(124,58,237,0.3);
    animation: none;
  }

  .header.scrolled .resume-link {
    box-shadow: 0 2px 8px rgba(124,58,237,0.15);
  }

  .header.scrolled .resume-link:hover {
    background: linear-gradient(135deg, #2563eb, #7c3aed, #e11d48);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(124,58,237,0.3);
  }
  
  .search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 12px;
    padding: 8px;
    background: none;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    cursor: pointer;
    color: var(--text-muted);
    transition: all 0.25s ease;
  }
  
  .search-btn:hover {
    color: var(--accent);
    background-color: var(--accent-subtle);
    border-color: var(--accent);
    transform: scale(1.05);
  }
  
  @media (max-width: 768px) {
    .header-inner {
      height: 52px;
      padding: 0 12px;
    }

    .nav {
      gap: 0;
    }

    .nav-link {
      font-size: 0.8rem;
      padding: 5px 8px;
    }

    .logo-name {
      font-size: 1.05rem;
    }

    .resume-link {
      display: none;
    }

    .insights-link {
      border: none !important;
      background: none !important;
      box-shadow: none !important;
      animation: none !important;
      padding: 5px 8px;
    }

    .insights-sparkle {
      display: none;
    }

    .search-btn {
      margin-left: 6px;
      padding: 6px;
    }

    .search-btn svg {
      width: 16px;
      height: 16px;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      padding: 0 8px;
    }

    .nav-link {
      font-size: 0.72rem;
      padding: 4px 5px;
    }

    .logo-name {
      font-size: 0.95rem;
      margin-right: 4px;
    }

    .search-btn {
      margin-left: 4px;
      padding: 5px;
    }
  }
</style>

<script>
  const searchButton = document.getElementById('search-button');
  searchButton?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('toggle-search'));
  });

  const header = document.querySelector('.header');
  if (header) {
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          header.classList.toggle('scrolled', window.scrollY > 80);
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }
</script>
